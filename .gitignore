# Build output
/out/

# Python bytecode from scripts/
__pycache__/

# arXiv submission bundles, produced by scripts/arxiv_bundle.sh
/arxiv-src/
/arxiv-check/

# LaTeX auxiliaries
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.log
*.run.xml
*.synctex.gz
*.synctex(busy)
*.toc
*.lof
*.lot
*.idx
*.ind
*.ilg
*.acn
*.acr
*.alg
*.glg
*.glo
*.gls
*.ist
*.nav
*.snm
*.vrb
*.xdv
_minted*/

# figures/ は PDF で管理するため除外しない。置き場所で種類が分かれる:
#   src/        ページの source (自分で書く)
#   generated/  src/ から build.sh が作ったもの (手で編集しない、消しても作り直せる)
#   assets/     自分で個別に作った図 (原本)
#   papers/     引用論文から取り出した図
!figures/
!figures/**

# figures/generated/ の PDF は figures/src/ のページから作るので管理しない (SVG は管理する)。
# latexmk が .latexmkrc から build.sh --pdf-only を呼んで、無いものと古いものを作る
/figures/generated/**/*.pdf

# ただし .github/tools/figures/build.sh の中間生成物は除外する。上の打ち消しより後に置くこと
# (build.sh は終了時に消すが、途中で止めると残る)
/figures/.build/
# Python のバイトコードも同様 (上の __pycache__/ は !figures/** に打ち消される)
/figures/**/__pycache__/

# PowerPoint / Office lock files
~$*
