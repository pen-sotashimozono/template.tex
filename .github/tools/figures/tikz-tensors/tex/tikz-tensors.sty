%% tikz-tensors.sty -- one TikZ format for tensor-network diagrams, in the shared
%% theme (theme/tokens.toml).
%%
%%   \usepackage{tikz-tensors}
%%
%% The notation distinguishes what a leg carries:
%%   cont   wavy leg, electron colour: a continuous argument (r, r_1, x)
%%   disc   plain line: a finite index (i, mu, a bond)
%% and what a node is:
%%   fn, fnwide, fntall      circle / rounded box, electron colour: a function of position
%%   coef, coefwide, coeftall square / box: an array of numbers (C, c, A^n)
%%   op, opwide              square-cornered box in ink: an operator (H, the MPO)
%%   frame                   dashed box around nodes that contract to one object
%% Joining two legs means summing over that index. So the expansion
%%   psi(r1, r2) = sum_ij C_ij phi_i(r1) phi_j(r2)
%% is a coefwide C with two disc legs down to two fn phi, each with a cont leg:
%% the numbers sit on the basis functions, which sit on space.
%%
%% Exchanging two fermion legs is \tnswap (a sign in the text, not in the drawing).
%% Colours (ele for continuous legs and functions, the page tokens tt<name>, and
%% the theme's other named colours) come from tikz-tensors-colors.tex, generated
%% from theme/tokens.toml. The version is the \ProvidesPackage line below.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{tikz-tensors}[2026/09/29 v0.2.0 tensor-network diagrams in one theme]

\RequirePackage{xcolor}
\RequirePackage{tikz}
\usetikzlibrary{decorations.pathmorphing,calc}
\input{tikz-tensors-colors.tex}

% ---- tensor diagrams ---------------------------------------------------------
\tikzset{
  fn/.style       = {circle, draw=ele, fill=ele!12, line width=0.9pt,
                     minimum size=8mm, inner sep=0pt},
  fnwide/.style   = {fn, rectangle, rounded corners=3.5mm, minimum width=17mm,
                     minimum height=8mm},
  fntall/.style   = {fn, rectangle, rounded corners=3.5mm, minimum width=8mm,
                     minimum height=17mm},
  coef/.style     = {rectangle, draw=black!80, fill=black!6, line width=0.9pt,
                     minimum size=7mm, inner sep=0pt},
  coefwide/.style = {coef, minimum width=17mm, minimum height=7mm},
  coeftall/.style = {coef, minimum width=7mm, minimum height=17mm},
  op/.style       = {rectangle, draw=ttfg, fill=white, line width=0.9pt,
                     minimum size=7mm, inner sep=1pt},
  opwide/.style   = {op, minimum width=17mm},
  frame/.style    = {draw=black!50, dashed, rounded corners=2mm, line width=0.7pt},
  cont/.style     = {draw=ele, line width=0.9pt, decorate,
                     decoration={snake, amplitude=0.55mm, segment length=2.4mm,
                                 pre length=0.4mm, post length=0.8mm}},
  disc/.style     = {draw=black!80, line width=0.9pt},
  leg/.style      = {font=\small, inner sep=2pt},
  tn swap cont/.style = {draw=ele, line width=0.9pt},
  tn swap disc/.style = {draw=black!80, line width=0.9pt},
}

% \tnswap[<kind>]{<left top>}{<right top>}{<drop>}
% Two legs that start at <left top> and <right top> and end <drop> lower,
% exchanged: short straight stubs of <kind> (cont or disc) at both ends, joined
% by a smooth crossing (a snake decoration on a diagonal reads as noise).
\makeatletter
\newcommand{\tnswap}[4][cont]{%
  \path #2 coordinate (tn@l) #3 coordinate (tn@r);
  \draw[#1] (tn@l) -- ++(0,-0.3) coordinate (tn@l1);
  \draw[#1] (tn@r) -- ++(0,-0.3) coordinate (tn@r1);
  \draw[#1] ($(tn@l)+(0,-#4)$) -- ++(0,0.3) coordinate (tn@l2);
  \draw[#1] ($(tn@r)+(0,-#4)$) -- ++(0,0.3) coordinate (tn@r2);
  \draw[tn swap #1] (tn@l1) .. controls +(0,-0.3) and +(0,0.3) .. (tn@r2);
  \draw[tn swap #1] (tn@r1) .. controls +(0,-0.3) and +(0,0.3) .. (tn@l2);
}
\makeatother

\endinput
